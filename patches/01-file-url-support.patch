+/**
+ * Load the raw body of a MyST xref or intersphinx inventory from either a local
+ * `file://` URL or a remote http(s) URL.
+ *
+ * This supports multi-project workspaces (monorepos / "kalaxies" of MyST sites)
+ * that want to resolve cross-references against already-built sibling projects
+ * on disk, without requiring the siblings to be deployed to a reachable URL.
+ *
+ * Returns the file text on success, or `undefined` on any failure. The caller
+ * decides how to log a failure (local-only, remote-only, or neither).
+ */
+async function fetchXrefBody(
+  session: ISession,
+  url: string,
+): Promise<{ ok: true; body: string } | { ok: false; status?: number }> {
+  if (url.startsWith('file://')) {
+    try {
+      const localPath = fileURLToPath(url);
+      if (fs.existsSync(localPath)) {
+        return { ok: true, body: fs.readFileSync(localPath, 'utf-8') };
+      }
+      session.log.debug(`Local xref file not found: ${localPath}`);
+      return { ok: false };
+    } catch (err) {
+      session.log.debug(`Error reading local xref file ${url}: ${(err as Error).message}`);
+      return { ok: false };
+    }
+  }
+  let resp: Response | undefined;
+  try {
+    resp = await session.fetch(url);
+  } catch {
+    session.log.debug(`Request to ${url} failed`);
+    return { ok: false };
+  }
+  if (resp?.status === 200) {
+    return { ok: true, body: await resp.text() };
+  }
+  return { ok: false, status: resp?.status };
+}
